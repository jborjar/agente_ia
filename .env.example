# =============================================================
# Agente IA - Variables de Entorno (Plantilla)
# =============================================================
# Copia este archivo a .env y configura los valores
# =============================================================

# Zona horaria
TZ=America/Mexico_City

# =============================================================
# STT - Speech to Text (Whisper)
# =============================================================
# Modelos: tiny, base, small, medium, large
# Mayor modelo = mejor precision pero mas lento
WHISPER_MODEL=small

# =============================================================
# TTS - Text to Speech (Coqui)
# =============================================================
# Modelo de voz para sintesis en espanol
COQUI_TTS_MODEL=tts_models/es/css10/vits

# =============================================================
# LLM - Modelos Ollama
# =============================================================
# Modelo para chat de texto y RAG (/ask)
# Con RAG no se necesita un modelo grande: solo extrae datos del contexto
# recuperado. qwen2.5:3b es ~3-4x mas rapido que qwen2.5:7b y usa menos RAM.
LLM_CHAT_MODEL=qwen2.5:3b

# Modelo para analisis de imagenes (requiere vision)
LLM_IMG_MODEL=llava:7b

# Modelo para analisis de documentos (requiere vision)
LLM_DOCS_MODEL=llava:7b

# Modelo de embeddings para RAG (busqueda semantica)
# nomic-embed-text: 768 dim, ~274 MB, multilingue
LLM_EMBED_MODEL=nomic-embed-text

# =============================================================
# Qdrant - Base vectorial para RAG
# =============================================================
# URL interna del servicio Qdrant
QDRANT_URL=http://qdrant:6333

# API key para proteger Qdrant (cambiar en produccion)
QDRANT_API_KEY=qdrant123

# =============================================================
# API Unificada
# =============================================================
# System prompt para el LLM (personalidad del asistente)
SYSTEM_PROMPT=Eres un asistente útil. Responde de forma concisa.
